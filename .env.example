# Copy to .env (cp .env.example .env && chmod 600 .env) and fill in the three secrets
N8N_VERSION=2.47.7
N8N_HOST_PORT=5678
GENERIC_TIMEZONE=Asia/Kolkata

# Encrypts credentials stored inside n8n; keep it stable once set (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
# Clients send this value in the X-API-Key header (openssl rand -hex 24)
WEBHOOK_API_KEY=
# Read only by scripts/setup.sh to create the n8n credential; never passed into the container
GEMINI_API_KEY=
