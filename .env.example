# Create .env with scripts/init-env.sh (it generates the secrets below)
N8N_VERSION=2.47.7
N8N_HOST_PORT=5678
GENERIC_TIMEZONE=Asia/Kolkata

# Encrypts credentials stored inside n8n; keep it stable once set
N8N_ENCRYPTION_KEY=
# Clients send this value in the X-API-Key header
WEBHOOK_API_KEY=
# Read only by host scripts to create the n8n credential; never passed into the container
GEMINI_API_KEY=
